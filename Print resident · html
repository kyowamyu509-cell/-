<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>利用者データ印刷</title>
<script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-database-compat.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Noto Sans JP','Hiragino Sans',sans-serif;background:#f0f4f8;color:#1e293b;font-size:14px}
.screen-wrap{max-width:860px;margin:0 auto;padding:20px}

/* 操作UI（印刷時非表示） */
.ctrl{background:#fff;border-radius:12px;border:1px solid #e2e8f0;padding:16px 20px;margin-bottom:16px;display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end}
.ctrl-group{display:flex;flex-direction:column;gap:5px}
.ctrl-label{font-size:11px;font-weight:600;color:#64748b}
.ctrl select,.ctrl input{border:1px solid #e2e8f0;border-radius:8px;padding:7px 10px;font-size:13px;color:#1e293b;background:#f8fafc;outline:none;font-family:inherit;min-width:180px}
.ctrl-btn{padding:8px 20px;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit}
.btn-primary{background:#4f46e5;color:#fff}
.btn-primary:hover{background:#4338ca}
.btn-gray{background:#f1f5f9;color:#64748b;border:1px solid #e2e8f0}
.status-msg{font-size:12px;color:#64748b;margin-top:6px}

/* A4印刷エリア */
.a4-page{background:#fff;width:210mm;min-height:297mm;margin:0 auto;padding:18mm 16mm;border:1px solid #ddd;position:relative}

/* ヘッダー */
.print-header{border-bottom:2px solid #1e293b;padding-bottom:8px;margin-bottom:14px;display:flex;justify-content:space-between;align-items:flex-end}
.print-title{font-size:18px;font-weight:700;color:#1e293b}
.print-meta{font-size:11px;color:#64748b;text-align:right;line-height:1.7}

/* 名前・部屋ブロック */
.name-block{display:flex;align-items:baseline;gap:12px;margin-bottom:16px;padding:10px 14px;background:#f8fafc;border-radius:8px;border:1px solid #e2e8f0}
.name-room{font-size:24px;font-weight:700;color:#4f46e5;min-width:52px}
.name-text{font-size:22px;font-weight:700;color:#1e293b}
.name-sub{font-size:12px;color:#64748b}

/* セクション */
.section{margin-bottom:14px}
.section-title{font-size:11px;font-weight:700;color:#64748b;letter-spacing:0.06em;border-bottom:1px solid #e2e8f0;padding-bottom:4px;margin-bottom:8px;text-transform:uppercase}

/* グリッド */
.field-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:8px}
.field-item{display:flex;flex-direction:column;gap:2px}
.field-label{font-size:9px;font-weight:600;color:#94a3b8}
.field-val{font-size:12px;color:#1e293b;font-weight:500;padding:4px 7px;border:0.5px solid #e2e8f0;border-radius:5px;background:#f8fafc;min-height:24px}
.field-val.v-ari{background:#eff6ff;color:#4f46e5;border-color:#a5b4fc}
.field-val.v-warn{background:#fff5f5;color:#dc2626;border-color:#fca5a5;font-weight:700}
.field-val.v-check{background:#eff6ff;color:#4f46e5}

/* 最終排便 */
.haiben-row{display:flex;align-items:center;gap:8px;padding:6px 10px;background:#f8fafc;border:0.5px solid #e2e8f0;border-radius:6px;margin-bottom:8px}
.haiben-label{font-size:10px;color:#64748b;font-weight:600;white-space:nowrap}
.haiben-val{font-size:14px;font-weight:700}

/* 申し送り */
.memo-box{border:0.5px solid #e2e8f0;border-radius:6px;padding:8px 10px;font-size:12px;color:#1e293b;line-height:1.8;min-height:48px;white-space:pre-wrap;background:#fafbfc}

/* 追加セクション */
.extra-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:8px}

/* 介助詳細 */
.cn-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.cn-item{display:flex;flex-direction:column;gap:2px}
.cn-label{font-size:9px;font-weight:700;color:#059669}
.cn-val{font-size:11px;color:#1e293b;line-height:1.7;padding:5px 8px;border:0.5px solid #d1fae5;border-radius:5px;background:#f9fffd;min-height:32px;white-space:pre-wrap}
.cn-val-wide{grid-column:1/-1}

/* フッター */
.print-footer{border-top:1px solid #e2e8f0;padding-top:8px;margin-top:16px;display:flex;justify-content:space-between;font-size:10px;color:#94a3b8}

/* 体重グラフ */
.wh-table{width:100%;border-collapse:collapse;font-size:11px}
.wh-table th{background:#f8fafc;padding:5px 8px;text-align:center;border:0.5px solid #e2e8f0;font-size:10px;color:#64748b;font-weight:600}
.wh-table td{padding:5px 8px;text-align:center;border:0.5px solid #e2e8f0}

/* 印刷スタイル */
@media print{
  @page{size:A4;margin:0}
  body{background:#fff}
  .ctrl,.no-print{display:none!important}
  .screen-wrap{padding:0;max-width:100%}
  .a4-page{border:none;margin:0;padding:14mm 14mm;width:100%;min-height:auto;page-break-after:always}
  .a4-page:last-child{page-break-after:avoid}
}
</style>
</head>
<body>
<div class="screen-wrap">
  <!-- 操作パネル（印刷時非表示） -->
  <div class="ctrl no-print">
    <div class="ctrl-group">
      <div class="ctrl-label">利用者を選択</div>
      <select id="residentSel"><option value="">読み込み中...</option></select>
    </div>
    <div class="ctrl-group">
      <div class="ctrl-label">記録日</div>
      <input type="date" id="printDate">
    </div>
    <div class="ctrl-group" style="flex-direction:row;gap:8px;align-items:flex-end">
      <button class="ctrl-btn btn-primary" onclick="loadAndRender()">📄 プレビュー</button>
      <button class="ctrl-btn btn-primary" onclick="window.print()">🖨️ 印刷</button>
      <button class="ctrl-btn btn-gray" onclick="history.back()">← 戻る</button>
    </div>
    <div class="status-msg" id="statusMsg">Firebaseに接続中...</div>
  </div>

  <!-- 印刷プレビュー -->
  <div id="printArea"></div>
</div>

<script>
const FIREBASE_CONFIG={apiKey:"AIzaSyBCUKrjGlyOqigYrwySaqQjUYRsyXv-_Ys",authDomain:"mousi-bab8c.firebaseapp.com",databaseURL:"https://mousi-bab8c-default-rtdb.asia-southeast1.firebasedatabase.app",projectId:"mousi-bab8c",storageBucket:"mousi-bab8c.firebasestorage.app",messagingSenderId:"560482916279",appId:"1:560482916279:web:153f51a24929f3dbc5ba32"};
let db=null;
try{
  firebase.initializeApp(FIREBASE_CONFIG);
  db=firebase.database();
  db.ref('.info/connected').on('value',s=>{
    document.getElementById('statusMsg').textContent=s.val()?'✅ Firebase接続完了':'⚠️ Firebase接続待機中...';
    if(s.val())loadResidents();
  });
}catch(e){document.getElementById('statusMsg').textContent='❌ 接続エラー: '+e.message;}

// URLパラメータ取得
const urlParams=new URLSearchParams(window.location.search);
const paramName=urlParams.get('name')||'';
const paramDate=urlParams.get('date')||'';
const paramSub=urlParams.get('sub')==='1';

// 今日の日付をセット
const today=new Date();
const todayStr=today.getFullYear()+'-'+String(today.getMonth()+1).padStart(2,'0')+'-'+String(today.getDate()).padStart(2,'0');
document.getElementById('printDate').value=paramDate||todayStr;

function normName(n){return(n||'').trim().replace(/[\s\u3000]+/g,'');}
function encKey(n){const norm=normName(n);return encodeURIComponent(norm).replace(/\./g,'%2E').replace(/#/g,'%23').replace(/\$/g,'%24').replace(/\[/g,'%5B').replace(/\]/g,'%5D');}
async function fbGet(path){if(!db)return null;try{const s=await db.ref(path).get();return s.exists()?s.val():null;}catch(e){return null;}}

// 利用者一覧を取得
async function loadResidents(){
  const sel=document.getElementById('residentSel');
  const names=new Set();
  try{
    const res=await fbGet('residents');
    if(res){
      Object.keys(res).forEach(k=>{
        const r=res[k];
        // room または sub_room があるアクティブな利用者
        try{
          const name=decodeURIComponent(k.replace(/%2E/g,'.').replace(/%23/g,'#').replace(/%24/g,'$').replace(/%5B/g,'[').replace(/%5D/g,']'));
          names.add(JSON.stringify({name,room:r.room||null,sub_room:r.sub_room||null}));
        }catch(e){}
      });
    }
  }catch(e){}
  const nameList=Array.from(names).map(s=>JSON.parse(s)).sort((a,b)=>a.name.localeCompare(b.name,'ja'));
  sel.innerHTML='<option value="">利用者を選択...</option>'+
    nameList.map(d=>{
      const roomLabel=d.room?` (${d.room}号室)`:d.sub_room?` (${d.sub_room}号室 入替)`:'';
      return`<option value="${encodeURIComponent(JSON.stringify(d))}">${d.name}${roomLabel}</option>`;
    }).join('');
  document.getElementById('statusMsg').textContent='✅ '+nameList.length+'名 読み込み完了';
  // URLパラメータで名前が指定されていれば自動選択・自動プレビュー
  if(paramName){
    const matchOpt=Array.from(sel.options).find(o=>{
      try{return JSON.parse(decodeURIComponent(o.value)).name===paramName;}catch(e){return false;}
    });
    if(matchOpt){sel.value=matchOpt.value;setTimeout(()=>loadAndRender(),200);}
  }
}

async function loadAndRender(){
  const selVal=document.getElementById('residentSel').value;
  if(!selVal){alert('利用者を選択してください');return;}
  const d=JSON.parse(decodeURIComponent(selVal));
  const printDate=document.getElementById('printDate').value;
  document.getElementById('statusMsg').textContent='読み込み中...';

  const k=encKey(d.name);
  const [todayData,latestData,careNotes,whData]=await Promise.all([
    fbGet('residents/'+k+'/dates/'+printDate),
    fbGet('residents/'+k+'/latest'),
    fbGet('residents/'+k+'/careNotes'),
    fbGet('wh/'+k),
  ]);

  const data=todayData||latestData||{};
  const cn=careNotes||{};
  const isToday=!!todayData;

  const fv=(val,ari=false,warn=false)=>{
    const cls=warn?'v-warn':ari?'v-ari':'';
    return`<div class="field-val${cls?(' '+cls):''}">${val||'—'}</div>`;
  };

  // 体重・身長（直近12ヶ月）
  let whRows='';
  if(whData){
    const months=Object.keys(whData).sort().slice(-12);
    whRows=months.map(m=>{
      const wd=whData[m]||{};
      const w=parseFloat(wd.weight)||0,h=parseFloat(wd.height)||0;
      const bmi=h>0?(w/((h/100)**2)).toFixed(1):'—';
      return`<tr><td>${m.replace('_','-')}</td><td>${wd.weight||'—'}</td><td>${wd.height||'—'}</td><td>${bmi}</td></tr>`;
    }).join('');
  }

  // 排便の警告チェック
  const hbn=parseInt(data.haiben);
  const hbWarn=data.haiben&&data.haiben!=='不明'&&!isNaN(hbn)&&hbn<=-3;

  // 介助詳細
  const shokujiParts=[];
  if(cn.shokuji_shushoku)shokujiParts.push('主食: '+cn.shokuji_shushoku);
  if(cn.shokuji_fukushoku)shokujiParts.push('副食: '+cn.shokuji_fukushoku);
  if(cn.shokuji_toro)shokujiParts.push('とろみ: '+cn.shokuji_toro);
  if(cn.shokuji_iero)shokujiParts.push('胃ろう使用');
  if(cn.shokuji_note)shokujiParts.push(cn.shokuji_note);
  const haisetsuParts=[];
  if(cn.omutsu&&cn.omutsu!=='なし')haisetsuParts.push('オムツ: '+cn.omutsu);
  if(cn.rehapan&&cn.rehapan!=='なし')haisetsuParts.push('リハパン: '+cn.rehapan);
  if(cn.pad&&cn.pad!=='なし')haisetsuParts.push('パッド: '+cn.pad);
  if(cn.haisetsu_basho)haisetsuParts.push('場所: '+cn.haisetsu_basho);
  if(cn.haisetsu_freq)haisetsuParts.push('頻度: '+cn.haisetsu_freq);
  if(cn.haisetsu_note)haisetsuParts.push(cn.haisetsu_note);
  const nyuyoku=[cn.nyuyoku_houhou,cn.nyuyoku_note].filter(Boolean).join('　');

  const cnRow=(label,val)=>val?`<div class="cn-item"><div class="cn-label">${label}</div><div class="cn-val">${val}</div></div>`:'';

  document.getElementById('printArea').innerHTML=`
  <div class="a4-page">
    <div class="print-header">
      <div class="print-title">ケア記録　利用者情報シート</div>
      <div class="print-meta">記録日: ${printDate}　${isToday?'（本日入力済み）':'（最新引継データ）'}<br>出力日時: ${new Date().toLocaleString('ja-JP')}</div>
    </div>

    <!-- 名前・部屋 -->
    <div class="name-block">
      <div class="name-room">${d.room||d.sub_room||'—'}号室</div>
      <div class="name-text">${d.name}</div>
      ${d.sub_room?'<div class="name-sub">（入替）</div>':''}
    </div>

    <!-- ケア記録 -->
    <div class="section">
      <div class="section-title">▌ ケア記録</div>
      <div class="field-grid">
        <div class="field-item"><div class="field-label">連絡帳</div>${fv(data.renrakucho,data.renrakucho==='有')}</div>
        <div class="field-item"><div class="field-label">薬変更</div>${fv(data.yakuhenkou,data.yakuhenkou==='有')}</div>
        <div class="field-item"><div class="field-label">目薬</div>${fv(data.megusuri,data.megusuri==='有')}</div>
        <div class="field-item"><div class="field-label">軟膏処置</div>${fv(data.nankou,data.nankou==='有')}</div>
      </div>
      <div class="field-grid" style="grid-template-columns:1fr 3fr">
        <div class="field-item">
          <div class="field-label">入浴（当日）</div>
          <div class="field-val${data.extra==='済'?' v-ari':''}">${data.extra==='済'?'✓ 入浴済み':'なし'}</div>
        </div>
        <div class="field-item">
          <div class="field-label">入浴方法（介助詳細）</div>
          <div class="field-val${nyuyoku?' v-ari':''}">${nyuyoku||'—'}</div>
        </div>
      </div>
      <div class="haiben-row">
        <span class="haiben-label">最終排便</span>
        <span class="haiben-val${hbWarn?' v-warn':''}" style="${hbWarn?'color:#dc2626':''}">${data.haiben||'未選択'}${data.haiben&&data.haiben!=='不明'&&data.haiben!=='0'?'日':''}</span>
        ${hbWarn?'<span style="font-size:11px;background:#fff5f5;color:#dc2626;padding:2px 8px;border-radius:20px;border:0.5px solid #fca5a5;font-weight:600">⚠ 要注意</span>':''}
      </div>
    </div>

    <!-- 追加情報 -->
    ${(data.rubber||data.bedNC||data.yakuNote||data.gaishuDate||data.gaishuNote)?`
    <div class="section">
      <div class="section-title">▌ 追加情報</div>
      <div class="extra-grid">
        ${data.rubber?`<div class="field-item"><div class="field-label">ラバー</div><div class="field-val">${data.rubber}</div></div>`:''}
        ${data.bedNC?`<div class="field-item"><div class="field-label">ベッド下NC</div><div class="field-val">${data.bedNC}</div></div>`:''}
        ${data.gaishuDate?`<div class="field-item"><div class="field-label">外出 月日</div><div class="field-val">${data.gaishuDate}</div></div>`:''}
        ${data.gaishuNote?`<div class="field-item"><div class="field-label">外出 要件</div><div class="field-val">${data.gaishuNote}</div></div>`:''}
        ${data.yakuNote?`<div class="field-item" style="grid-column:1/-1"><div class="field-label">薬関連（変更内容）</div><div class="field-val" style="white-space:pre-wrap">${data.yakuNote}</div></div>`:''}
      </div>
    </div>
    `:''}

    <!-- 申し送り -->
    <div class="section">
      <div class="section-title">▌ 申し送り</div>
      <div class="memo-box">${data.memo||'（申し送りなし）'}</div>
    </div>

    <!-- 介助詳細 -->
    <div class="section">
      <div class="section-title">▌ 介助詳細</div>
      <div class="cn-grid">
        ${cn.shintai?`<div class="cn-item cn-val-wide"><div class="cn-label">🏥 身体情報・注意事項</div><div class="cn-val cn-val-wide" style="color:#dc2626;border-color:#fca5a5;background:#fff5f5">${cn.shintai}</div></div>`:''}
        ${cnRow('🚶 移動・移乗',cn.ido)}
        ${shokujiParts.length?cnRow('🍚 食事',shokujiParts.join(' / ')):''}
        ${nyuyoku?cnRow('🛁 入浴',nyuyoku):''}
        ${haisetsuParts.length?cnRow('🚽 排泄',haisetsuParts.join(' / ')):''}
        ${cn.sonota?`<div class="cn-item cn-val-wide"><div class="cn-label">📝 その他・特記事項</div><div class="cn-val">${cn.sonota}</div></div>`:''}
      </div>
      ${!cn.shintai&&!cn.ido&&!shokujiParts.length&&!nyuyoku&&!haisetsuParts.length&&!cn.sonota?'<div style="font-size:12px;color:#94a3b8;text-align:center;padding:12px 0">介助詳細の登録がありません</div>':''}
    </div>

    <!-- 体重・身長 -->
    ${whRows?`
    <div class="section">
      <div class="section-title">▌ 体重・身長（直近12ヶ月）</div>
      <table class="wh-table">
        <thead><tr><th>年月</th><th>体重(kg)</th><th>身長(cm)</th><th>BMI</th></tr></thead>
        <tbody>${whRows}</tbody>
      </table>
    </div>
    `:''}

    <div class="print-footer">
      <span>施設日常ケア記録システム</span>
      <span>${d.name}　${d.room||d.sub_room||''}号室　${printDate}</span>
    </div>
  </div>`;

  document.getElementById('statusMsg').textContent='✅ プレビュー完了。「印刷」ボタンで印刷してください。';
}
</script>
</body>
</html>
